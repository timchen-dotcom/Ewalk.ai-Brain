rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function role() {
      return signedIn() && userDoc().data.role is string ? userDoc().data.role : "guest";
    }

    function isAdmin() {
      return signedIn() && role() in ["owner", "admin"];
    }

    function isStaff() {
      return signedIn() && role() in ["owner", "admin", "manager", "staff", "agent"];
    }

    function isClientUser(clientId) {
      return signedIn()
        && role() == "client"
        && clientId in userDoc().data.client_ids;
    }

    match /clients/{clientId}/{allPaths=**} {
      allow read: if isStaff() || isClientUser(clientId);
      allow write: if isStaff() || isClientUser(clientId);
      allow delete: if isAdmin();
    }

    match /system/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /tmp/{uid}/{allPaths=**} {
      allow read, write, delete: if signedIn() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
